{
  "name": "hermes-bot-mode",
  "version": "0.4.0",
  "description": "Desktop plugin for Hermes Agent — roster of named bots with avatars, cron, and bot-to-bot messaging",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.mjs",
    "test:verbose": "node --test --test-reporter=spec tests/*.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@hermes/plugin-sdk": "*",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@hermes/plugin-sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^26.2.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "hermes",
    "desktop-plugin",
    "agents"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
